---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { regionOf } from '../lib/regions';

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
}

const { title, description = 'The best vegan food in every city. Short lists, strong opinions, zero filler.', fullBleed = false } = Astro.props;

const cities = await getCollection('cities');
const slugOf = (e) => e.id.replace(/\.mdx?$/, '');
const vpData = {
  cities: cities.map((c) => ({
    slug: slugOf(c),
    title: c.data.title,
    country: c.data.country,
    region: regionOf(c.data.country),
    status: c.data.status,
    lat: c.data.lat ?? null,
    lng: c.data.lng ?? null,
  })),
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · vegan.place</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href="/"><img class="brand-mark" src="/favicon.svg" alt="" /> vegan.place</a>
      <nav>
        <a href="/">Cities</a>
        <a href="/methodology">How we pick</a>
      </nav>
    </header>

    <main class={fullBleed ? 'explorer-main' : undefined}>
      <slot />
    </main>

    {!fullBleed && (
      <footer>
        <p><span class="foot-brand"><img class="brand-mark" src="/favicon.svg" alt="" /> vegan.place</span></p>
        <p>A field guide to the best vegan food in every city. No ads. No pay-to-play. Just the good stuff, re-checked monthly.</p>
        <p class="fine">psst — the konami code makes it rain vegetables.</p>
      </footer>
    )}

    <script type="application/json" id="vp-data" set:html={JSON.stringify(vpData)} />

    <script is:inline>
      // ---- tried-it tracker (localStorage, no accounts) ----
      // Classic inline script on purpose: it must run during parsing, before
      // the deferred module scripts on city/spot pages read window.VP.
      window.VP = {
        key: 'vp-tasted-v1',
        get() {
          try { return JSON.parse(localStorage.getItem(this.key)) || []; }
          catch { return []; }
        },
        has(slug) { return this.get().includes(slug); },
        toggle(slug) {
          const t = this.get();
          const i = t.indexOf(slug);
          if (i >= 0) t.splice(i, 1); else t.push(slug);
          localStorage.setItem(this.key, JSON.stringify(t));
          return i < 0;
        },
      };

      // ---- veggie rain (konami code easter egg) ----
      const VEGGIES = ['🥑','🥦','🌮','🍕','🥕','🍄','🥬','🍓','🫘','🌽','🍋','🥥'];
      function veggieRain(n) {
        const count = n || 70;
        for (let i = 0; i < count; i++) {
          const s = document.createElement('span');
          s.className = 'veg-drop';
          s.textContent = VEGGIES[Math.floor(Math.random() * VEGGIES.length)];
          s.style.left = Math.random() * 100 + 'vw';
          s.style.fontSize = (1.4 + Math.random() * 2.2) + 'rem';
          s.style.animationDuration = (2.2 + Math.random() * 2.4) + 's';
          s.style.animationDelay = (Math.random() * 1.2) + 's';
          document.body.appendChild(s);
          setTimeout(() => s.remove(), 6000);
        }
      }
      const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
      let pos = 0;
      document.addEventListener('keydown', (e) => {
        pos = (e.key === seq[pos]) ? pos + 1 : (e.key === seq[0] ? 1 : 0);
        if (pos === seq.length) { pos = 0; veggieRain(); }
      });

      // ---- first-visit sprinkle (once per device) ----
      try {
        if (!localStorage.getItem('vp-seen-v1')) {
          localStorage.setItem('vp-seen-v1', '1');
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            setTimeout(() => veggieRain(25), 1000);
          }
        }
      } catch (e) { /* storage unavailable: no sprinkle */ }
    </script>
  </body>
</html>
