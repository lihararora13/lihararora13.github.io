---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'The best vegan food in every city. Short lists, strong opinions, zero filler.' } = Astro.props;

const spots = await getCollection('restaurants');
const cities = await getCollection('cities');
const slugOf = (e) => e.id.replace(/\.mdx?$/, '');
const vpData = {
  spots: spots.map((s) => ({
    slug: slugOf(s),
    name: s.data.name,
    city: s.data.city,
    cuisine: s.data.cuisine,
    summary: s.data.summary,
    rank: s.data.rank,
  })),
  cities: cities.map((c) => ({ slug: slugOf(c), title: c.data.title, status: c.data.status })),
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · vegan.place</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-head">
      <a class="brand" href="/"><span class="leaf">🌱</span> vegan.place</a>
      <nav>
        <a href="/#cities">Cities</a>
        <a href="/methodology">How we pick</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p><strong>🌱 vegan.place</strong> — the best vegan food in every city.</p>
      <p>No ads. No pay-to-play. Just the good stuff, re-checked monthly.</p>
      <p style="font-size: 0.8rem; opacity: 0.7;">psst — the konami code makes it rain vegetables.</p>
    </footer>

    <script type="application/json" id="vp-data" set:html={JSON.stringify(vpData)} />

    <script>
      // ---- tried-it tracker (localStorage, no accounts) ----
      window.VP = {
        key: 'vp-tasted-v1',
        get() {
          try { return JSON.parse(localStorage.getItem(this.key)) || []; }
          catch { return []; }
        },
        has(slug) { return this.get().includes(slug); },
        toggle(slug) {
          const t = this.get();
          const i = t.indexOf(slug);
          if (i >= 0) t.splice(i, 1); else t.push(slug);
          localStorage.setItem(this.key, JSON.stringify(t));
          return i < 0;
        },
      };

      // ---- veggie rain (konami code easter egg) ----
      const VEGGIES = ['🥑','🥦','🌮','🍕','🥕','🍄','🥬','🍓','🫘','🌽','🍋','🥥'];
      function veggieRain() {
        for (let i = 0; i < 70; i++) {
          const s = document.createElement('span');
          s.className = 'veg-drop';
          s.textContent = VEGGIES[Math.floor(Math.random() * VEGGIES.length)];
          s.style.left = Math.random() * 100 + 'vw';
          s.style.fontSize = (1.4 + Math.random() * 2.2) + 'rem';
          s.style.animationDuration = (2.2 + Math.random() * 2.4) + 's';
          s.style.animationDelay = (Math.random() * 1.2) + 's';
          document.body.appendChild(s);
          setTimeout(() => s.remove(), 6000);
        }
      }
      const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
      let pos = 0;
      document.addEventListener('keydown', (e) => {
        pos = (e.key === seq[pos]) ? pos + 1 : (e.key === seq[0] ? 1 : 0);
        if (pos === seq.length) { pos = 0; veggieRain(); }
      });
    </script>
  </body>
</html>
