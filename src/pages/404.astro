---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="hero-wrap" style="text-align: center;">
    <span class="float-veg" style="top: 15%; left: 10%; animation-delay: 0s;" aria-hidden="true">🥬</span>
    <span class="float-veg" style="bottom: 20%; right: 12%; animation-delay: 1.8s;" aria-hidden="true">🍄</span>
    <p class="hero-kicker">🥬 404</p>
    <h1 class="hero">This page is <span class="hl">compost.</span></h1>
    <p class="lede" style="margin: 0 auto;">
      It wilted, we composted it, something better will grow here. Let's get you
      back to the delicious stuff.
    </p>
    <div class="btn-row" style="justify-content: center;">
      <a class="btn solid" href="/">Back to the good stuff</a>
      <a class="btn" href="/#cities">Browse cities</a>
    </div>
  </div>
</Base>
