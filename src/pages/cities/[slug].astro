---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { slug: city.id.replace(/\.mdx?$/, '') },
    props: { city },
  }));
}

const { city } = Astro.props;
const { Content } = await render(city);
const citySlug = city.id.replace(/\.mdx?$/, '');
const allSpots = await getCollection('restaurants');
const targets = allSpots
  .filter((s) => s.data.city === citySlug)
  .sort((a, b) => a.data.rank - b.data.rank);

const movementLabel = { new: 'New!', up: 'Climbing ↑', down: 'Slipping ↓', same: '' };
const movementClass = { new: 'new', up: 'vegan', down: 'plain', same: '' };
const priceMarks = (n) => '$'.repeat(n);
---

<Base title={`${city.data.title} vegan guide`} description={city.data.summary}>
  <p class="hero-kicker">🗺️ City guide</p>
  <h1 class="hero">{city.data.title}</h1>
  <p class="lede">{city.data.summary}</p>

  {city.data.status === 'live' ? (
    <>
      <div class="progress-wrap" data-targets={targets.map((t) => t.id.replace(/\.mdx?$/, '')).join(',')}>
        <p class="progress-label" id="progress-label"></p>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width: 0%"></div></div>
      </div>
      {targets.map((t) => (
        <div class={`rank-row${t.data.rank === 1 ? ' top-pick' : ''}`} data-spot={t.id.replace(/\.mdx?$/, '')}>
          <div class="rank-num">{t.data.rank}</div>
          <div>
            <h3>
              <a href={`/spots/${t.id.replace(/\.mdx?$/, '')}/`}>{t.data.name}</a>
            </h3>
            <p style="margin: 0.2rem 0;">
              {t.data.rank === 1 && <span class="sticker top">👑 Top pick</span>}
              <span class={`sticker ${t.data.veganStatus === 'all-vegan' ? 'vegan' : 'friendly'}`}>
                {t.data.veganStatus === 'all-vegan' ? '🌱 100% vegan' : 'Vegan-friendly'}
              </span>
              {movementLabel[t.data.movement] && (
                <span class={`sticker ${movementClass[t.data.movement]}`}>{movementLabel[t.data.movement]}</span>
              )}
            </p>
            <p class="meta">{t.data.neighborhood} · {t.data.cuisine.join(', ')} · {priceMarks(t.data.price)}</p>
            <p class="desc">{t.data.summary}</p>
          </div>
        </div>
      ))}
      <hr class="divider" />
      <div class="section-head"><h2>The lowdown</h2></div>
      <div class="rundown">
        <Content />
      </div>
    </>
  ) : (
    <>
      <div class="note-card" style="margin-top: 1.5rem;">
        🚧 {city.data.title} is on the list, but we're still tasting our way through it.
        Good things take time (and many meals).
      </div>
      <div class="section-head"><h2>The lowdown</h2></div>
      <div class="rundown">
        <Content />
      </div>
    </>
  )}

  <script>
    const wrap = document.querySelector('.progress-wrap');
    if (wrap) {
      const slugs = wrap.dataset.targets.split(',').filter(Boolean);
      const label = document.getElementById('progress-label');
      const fill = document.getElementById('progress-fill');
      const update = () => {
        const n = slugs.filter((s) => window.VP.has(s)).length;
        const pct = slugs.length ? Math.round((n / slugs.length) * 100) : 0;
        label.textContent = n === 0
          ? `Tried 0 of ${slugs.length} — your delicious journey awaits 🥬`
          : n === slugs.length
            ? `All ${slugs.length} tried. Certified local legend 🏆`
            : `You've tried ${n} of ${slugs.length} — keep munching 🍽️`;
        fill.style.width = pct + '%';
        slugs.forEach((s) => {
          const row = document.querySelector(`[data-spot="${s}"]`);
          if (row) row.classList.toggle('tasted', window.VP.has(s));
        });
      };
      update();
      window.addEventListener('storage', update);
      setInterval(update, 1000);
    }
  </script>
</Base>
