---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((city) => ({
    params: { slug: city.id.replace(/\.mdx?$/, '') },
    props: { city },
  }));
}

const { city } = Astro.props;
const { Content } = await render(city);
const citySlug = city.id.replace(/\.mdx?$/, '');
const allSpots = await getCollection('restaurants');
const targets = allSpots
  .filter((s) => s.data.city === citySlug)
  .sort((a, b) => a.data.rank - b.data.rank);

const movementLabel = { new: 'New!', up: 'Climbing ↑', down: 'Slipping ↓', same: '' };
const movementClass = { new: '', up: '', down: 'plain', same: '' };
const priceMarks = (n) => '$'.repeat(n);
const latestVerified = targets.reduce((m, t) => Math.max(m, t.data.lastVerified.getTime()), 0);
const verifiedLabel = latestVerified ? new Date(latestVerified).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase() : '';
---

<Base title={`${city.data.title} vegan guide`} description={city.data.summary}>
  <div class="city-head">
    <div>
      <p class="eyebrow">City guide · {city.data.country}</p>
      <h1 class="hero">{city.data.title}</h1>
    </div>
    {city.data.status === 'live' && (
      <div class="stamp" aria-hidden="true">
        <span class="stamp-top">Vegan.place</span>
        <span class="stamp-mid">Verified</span>
        <span class="stamp-bot">{verifiedLabel}</span>
      </div>
    )}
  </div>
  <p class="lede">{city.data.summary}</p>

  {city.data.status === 'live' ? (
    <>
      <div class="progress-wrap" data-targets={targets.map((t) => t.id.replace(/\.mdx?$/, '')).join(',')}>
        <p class="progress-label" id="progress-label"></p>
        <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width: 0%"></div></div>
      </div>
      <div class="section-head">
        <h2>The atlas</h2>
        <p class="sub">Every spot in this guide, pinned. Bring an appetite.</p>
      </div>
      <div id="city-map"></div>
      <p class="map-caption">Atlas — {city.data.title} · {targets.length} stamps</p>
      <script
        type="application/json"
        id="city-pins"
        set:html={JSON.stringify(
          targets
            .filter((t) => t.data.lat != null && t.data.lng != null)
            .map((t) => ({
              slug: t.id.replace(/\.mdx?$/, ''),
              name: t.data.name,
              rank: t.data.rank,
              neighborhood: t.data.neighborhood,
              lat: t.data.lat,
              lng: t.data.lng,
            }))
        )}
      />
      {targets.map((t) => (
        <div class={`rank-row${t.data.rank === 1 ? ' top-pick' : ''}`} data-spot={t.id.replace(/\.mdx?$/, '')}>
          <div class="rank-num">{t.data.rank}</div>
          <div>
            <h3>
              <a href={`/spots/${t.id.replace(/\.mdx?$/, '')}/`}>{t.data.name}</a>
            </h3>
            <p style="margin: 0.2rem 0;">
              {t.data.rank === 1 && <span class="tag top">Editor's pick</span>}
              <span class={`tag ${t.data.veganStatus === 'all-vegan' ? '' : 'friendly'}`}>
                {t.data.veganStatus === 'all-vegan' ? '100% vegan' : 'Vegan-friendly'}
              </span>
              {movementLabel[t.data.movement] && (
                <span class={`tag ${movementClass[t.data.movement]}`}>{movementLabel[t.data.movement]}</span>
              )}
            </p>
            <p class="meta">{t.data.neighborhood} · {t.data.cuisine.join(', ')} · {priceMarks(t.data.price)}</p>
            <p class="desc">{t.data.summary}</p>
          </div>
        </div>
      ))}
      <hr class="divider" />
      <div class="section-head"><h2>The lowdown</h2></div>
      <div class="rundown">
        <Content />
      </div>
    </>
  ) : (
    <>
      <div class="note-card" style="margin-top: 1.5rem;">
        {city.data.title} is on the list, but we're still tasting our way through it.
        Good things take time (and many meals).
      </div>
      <div class="section-head"><h2>The lowdown</h2></div>
      <div class="rundown">
        <Content />
      </div>
    </>
  )}

  <script>
    const wrap = document.querySelector('.progress-wrap');
    if (wrap) {
      const slugs = wrap.dataset.targets.split(',').filter(Boolean);
      const label = document.getElementById('progress-label');
      const fill = document.getElementById('progress-fill');
      const update = () => {
        // VP is defined by the layout's inline script, but never let a
        // missing VP kill this module (and the map code below it).
        if (!window.VP) return;
        const n = slugs.filter((s) => window.VP.has(s)).length;
        const pct = slugs.length ? Math.round((n / slugs.length) * 100) : 0;
        label.textContent = n === 0
          ? `0 of ${slugs.length} stamps collected — your passport awaits its first stamp`
          : n === slugs.length
            ? `All ${slugs.length} stamps collected. Certified local legend`
            : `${n} of ${slugs.length} stamps collected — keep collecting`;
        fill.style.width = pct + '%';
        slugs.forEach((s) => {
          const row = document.querySelector(`[data-spot="${s}"]`);
          if (row) row.classList.toggle('tasted', window.VP.has(s));
        });
      };
      update();
      window.addEventListener('storage', update);
      setInterval(update, 1000);
    }

    // ---- city map (Leaflet, lazy-loaded like the region hubs) ----
    const mapEl = document.getElementById('city-map');
    if (mapEl) {
      const pins = JSON.parse(document.getElementById('city-pins').textContent || '[]');
      if (!pins.length) {
        mapEl.hidden = true;
        const head = mapEl.previousElementSibling;
        if (head) head.hidden = true;
      } else {
        let leafletLoading = null;
        function loadLeaflet() {
          if (window.L) return Promise.resolve();
          if (!leafletLoading) {
            leafletLoading = new Promise((resolve, reject) => {
              const s = document.createElement('script');
              s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
              s.onload = resolve;
              s.onerror = () => reject(new Error('Leaflet failed to load'));
              document.head.appendChild(s);
            });
          }
          return leafletLoading;
        }
        loadLeaflet().then(() => {
          const map = window.L.map('city-map', { scrollWheelZoom: false });
          window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          }).addTo(map);
          const bounds = [];
          pins.forEach((p) => {
            const marker = window.L.marker([p.lat, p.lng], {
              icon: window.L.divIcon({
                className: 'vp-pin',
                html: '<span></span>',
                iconSize: [18, 18],
                iconAnchor: [9, 9],
              }),
            }).addTo(map);
            marker.bindPopup(
              '<strong>#' + p.rank + ' <a href="/spots/' + p.slug + '/">' + p.name + '</a></strong><br>' + p.neighborhood
            );
            bounds.push([p.lat, p.lng]);
          });
          if (bounds.length === 1) map.setView(bounds[0], 15);
          else map.fitBounds(bounds, { padding: [28, 28] });
        }).catch(() => {
          mapEl.innerHTML = '<p class="no-results">The map could not load. The ranked list below has every address.</p>';
        });
      }
    }
  </script>
</Base>
