---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { REGIONS, regionOf } from '../lib/regions';

const cities = await getCollection('cities');
const live = cities.filter((c) => c.data.status === 'live');
const spots = await getCollection('restaurants');
const slugOf = (e) => e.id.replace(/\.mdx?$/, '');

const spotsByCity = new Map<string, number>();
for (const s of spots) {
  spotsByCity.set(s.data.city, (spotsByCity.get(s.data.city) ?? 0) + 1);
}
const sorted = [...live].sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title="The best vegan food in every city" fullBleed>
  <div class="explorer">
    <div id="world-map" class="explorer-map"></div>
    <aside class="explorer-panel" aria-label="Find a city">
      <div class="panel-head">
        <p class="panel-count">{live.length} cities · {spots.length} spots</p>
        <input id="city-search" type="search" placeholder="Search a city…" aria-label="Search cities" autocomplete="off" />
      </div>
      <div class="panel-chips" role="group" aria-label="Filter by region">
        <button class="chip active" data-region="All" type="button">All</button>
        {REGIONS.map((r) => (
          <button class="chip" data-region={r} type="button">{r}</button>
        ))}
      </div>
      <nav class="panel-list" id="panel-list">
        {sorted.map((c) => (
          <a
            class="panel-row"
            href={`/cities/${slugOf(c)}/`}
            data-name={(c.data.title + ' ' + c.data.country).toLowerCase()}
            data-region={regionOf(c.data.country)}
          >
            <span class="panel-row-name">{c.data.title}</span>
            <span class="panel-row-meta">{c.data.country} · {spotsByCity.get(slugOf(c)) ?? 0} spots</span>
          </a>
        ))}
      </nav>
      <div class="panel-foot">
        <button class="btn solid" id="surprise-me" type="button">Surprise me</button>
        <a href="/methodology">How we pick →</a>
      </div>
    </aside>
  </div>

  <script>
    const data = JSON.parse(document.getElementById('vp-data').textContent || '{}');
    const allCities = (data.cities || []).filter(
      (c) => c.status === 'live' && c.lat != null && c.lng != null
    );

    // ---- world map (Leaflet, lazy-loaded like the region hubs) ----
    const worldMapEl = document.getElementById('world-map');
    let map = null;
    let markers = [];
    if (worldMapEl) {
      let leafletLoading = null;
      function loadLeaflet() {
        if (window.L) return Promise.resolve();
        if (!leafletLoading) {
          leafletLoading = new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
            s.onload = resolve;
            s.onerror = () => reject(new Error('Leaflet failed to load'));
            document.head.appendChild(s);
          });
        }
        return leafletLoading;
      }
      loadLeaflet().then(() => {
        map = window.L.map('world-map', { scrollWheelZoom: true, zoomControl: false });
        window.L.control.zoom({ position: 'bottomright' }).addTo(map);
        window.L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);
        const bounds = [];
        markers = allCities.map((c) => {
          const marker = window.L.marker([c.lat, c.lng], {
            icon: window.L.divIcon({
              className: 'vp-pin',
              html: '<span></span>',
              iconSize: [18, 18],
              iconAnchor: [9, 9],
            }),
          }).addTo(map);
          marker.bindPopup(
            '<a href="/cities/' + c.slug + '/"><strong>' + c.title + '</strong></a><br>' + c.country
          );
          marker._region = c.region;
          bounds.push([c.lat, c.lng]);
          return marker;
        });
        if (bounds.length) map.fitBounds(bounds, { padding: [28, 28] });
        else map.setView([20, 0], 2);
      }).catch(() => {
        worldMapEl.innerHTML = '<p class="no-results">The map could not load. The city list in the panel has every guide.</p>';
      });
    }

    // ---- panel: search + region chips filter the list and the pins ----
    const citySearch = document.getElementById('city-search');
    const rows = Array.from(document.querySelectorAll('.panel-row'));
    let activeRegion = 'All';

    function applyFilters() {
      const q = (citySearch.value || '').trim().toLowerCase();
      rows.forEach((row) => {
        const okQ = !q || row.dataset.name.includes(q);
        const okR = activeRegion === 'All' || row.dataset.region === activeRegion;
        row.style.display = okQ && okR ? '' : 'none';
      });
      if (map) {
        markers.forEach((m) => {
          const show = activeRegion === 'All' || m._region === activeRegion;
          if (show && !map.hasLayer(m)) m.addTo(map);
          if (!show && map.hasLayer(m)) map.removeLayer(m);
        });
      }
    }

    if (citySearch) citySearch.addEventListener('input', applyFilters);
    document.querySelectorAll('.panel-chips .chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.panel-chips .chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        activeRegion = chip.dataset.region;
        applyFilters();
      });
    });

    // ---- surprise me: jump to a random guide ----
    const surprise = document.getElementById('surprise-me');
    if (surprise) {
      surprise.addEventListener('click', () => {
        const c = allCities[Math.floor(Math.random() * allCities.length)];
        if (c) window.location.href = '/cities/' + c.slug + '/';
      });
    }
  </script>
</Base>
