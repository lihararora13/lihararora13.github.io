---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { REGIONS, regionOf, regionSlug } from '../lib/regions';

const cities = await getCollection('cities');
const live = cities.filter((c) => c.data.status === 'live');
const soon = cities.filter((c) => c.data.status === 'soon');
const spots = await getCollection('restaurants');
const slugOf = (e) => e.id.replace(/\.mdx?$/, '');

// Most recent verification per city, used to pick headline cities per region.
const latestByCity = new Map<string, number>();
for (const s of spots) {
  const t = s.data.lastVerified.getTime();
  if (!latestByCity.has(s.data.city) || t > (latestByCity.get(s.data.city) as number)) {
    latestByCity.set(s.data.city, t);
  }
}
const byRegion = (region: string) =>
  live
    .filter((c) => regionOf(c.data.country) === region)
    .sort(
      (a, b) =>
        (latestByCity.get(slugOf(b)) ?? 0) - (latestByCity.get(slugOf(a)) ?? 0)
    );
---

<Base title="The best vegan food in every city">
  <div class="hero-wrap">
    <p class="eyebrow">A field guide to plant-based eating</p>
    <h1 class="hero">
      The best <em>vegan food</em><br />
      in every city.
    </h1>
    <p class="lede">
      Short lists, strong opinions. We hunt down the plant-based spots actually worth
      your time, rank them, and re-check them every month. No ads, no pay-to-play,
      no 400-entry directory of places that once had a veggie burger.
    </p>
    <div class="hero-stats">
      <div><strong>{live.length}</strong><span>City guides</span></div>
      <div><strong>{spots.length}</strong><span>Spots ranked</span></div>
      <div><strong>Monthly</strong><span>Re-checked</span></div>
    </div>
    <div class="btn-row">
      <a class="btn solid" href="#regions">Browse by region</a>
      <a class="btn" href="/methodology">How we pick</a>
    </div>
  </div>

  <div class="section-head" id="regions">
    <h2>Browse by region</h2>
    <p class="sub">{live.length} ranked guides across five regions. Pick a region, or search for a city.</p>
  </div>
  <div class="city-tools">
    <input id="city-search" type="search" placeholder="Search cities… (e.g. paris, texas)" aria-label="Search cities" autocomplete="off" />
  </div>
  <div id="search-results" class="search-results" hidden></div>
  <div class="region-cards">
    {REGIONS.map((region) => {
      const items = byRegion(region);
      const headlines = items.slice(0, 3);
      return (
        <a class="region-card" href={`/regions/${regionSlug(region)}/`}>
          <p class="eyebrow">{region}</p>
          <p class="region-count"><strong>{items.length}</strong> {items.length === 1 ? 'guide' : 'guides'}</p>
          <p class="region-headlines">
            {headlines.map((c) => c.data.title).join(' · ')}
            {soon.some((c) => regionOf(c.data.country) === region) && ' · more coming soon'}
          </p>
          <span class="region-link">Explore {region} →</span>
        </a>
      );
    })}
  </div>

  <hr class="divider" />
  <div class="note-card">
    This is a short list, not a phone book. If a city has twelve spots worth your
    time, the list has twelve entries. If it has three, it has three.
  </div>

  <script>
    const data = JSON.parse(document.getElementById('vp-data').textContent || '{}');

    // City search: live results jump straight to the guide.
    const citySearch = document.getElementById('city-search');
    const searchResults = document.getElementById('search-results');
    const allCities = (data.cities || []).filter((c) => c.status === 'live');

    function renderSearch() {
      const q = (citySearch.value || '').trim().toLowerCase();
      if (!q) { searchResults.hidden = true; searchResults.innerHTML = ''; return; }
      const hits = allCities
        .filter((c) => (c.title + ' ' + c.country).toLowerCase().includes(q))
        .slice(0, 8);
      if (!hits.length) {
        searchResults.hidden = false;
        searchResults.innerHTML = '<p class="no-results">No city matches that search. Try another craving?</p>';
        return;
      }
      searchResults.hidden = false;
      searchResults.innerHTML = hits.map((c) =>
        '<a class="search-hit" href="/cities/' + c.slug + '/">' +
        '<span class="search-hit-name">' + c.title + '</span>' +
        '<span class="search-hit-meta">' + c.country + ' · ' + c.region + '</span>' +
        '</a>'
      ).join('');
    }

    if (citySearch) citySearch.addEventListener('input', renderSearch);
  </script>
</Base>
