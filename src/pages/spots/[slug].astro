---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const spots = await getCollection('restaurants');
  return spots.map((spot) => ({
    params: { slug: spot.id.replace(/\.mdx?$/, '') },
    props: { spot },
  }));
}

const { spot } = Astro.props;
const { Content } = await render(spot);
const cities = await getCollection('cities');
const city = cities.find((c) => c.id.replace(/\.mdx?$/, '') === spot.data.city);
const priceMarks = (n) => '$'.repeat(n);
const verified = spot.data.lastVerified.toISOString().slice(0, 10);
---

<Base title={`DOSSIER: ${spot.data.name.toUpperCase()}`} description={spot.data.summary}>
  <div class="dossier-head">
    <p class="hero-kicker prompt">TARGET DOSSIER // FILE #{String(spot.data.rank).padStart(3, '0')}</p>
    <h1>{spot.data.name}</h1>
    <p>
      {spot.data.rank === 1 && <span class="stamp apex">APEX PREDATOR</span>}
      <span class={`stamp ${spot.data.veganStatus === 'all-vegan' ? 'vegan' : 'friendly'}`}>
        {spot.data.veganStatus === 'all-vegan' ? '100% VEGAN' : 'VEGAN-FRIENDLY'}
      </span>
      <span class="stamp" style="color: var(--ink-dim)">{priceMarks(spot.data.price)}</span>
    </p>
    <p class="meta">
      RANKED #{spot.data.rank} IN <a href={`/cities/${spot.data.city}/`}>{city?.data.title.toUpperCase()}</a>
    </p>
    <div class="btn-row">
      <button class="btn" id="tasted-btn" data-slug={spot.id.replace(/\.mdx?$/, '')}>MARK AS TASTED</button>
    </div>
  </div>

  <dl class="intel">
    <div><dt>CUISINE</dt><dd>{spot.data.cuisine.join(', ')}</dd></div>
    <div><dt>NEIGHBORHOOD</dt><dd>{spot.data.neighborhood}</dd></div>
    <div><dt>ADDRESS</dt><dd>{spot.data.address}</dd></div>
    <div><dt>PRICE</dt><dd>{priceMarks(spot.data.price)} {spot.data.price === 1 ? '(cheap eats)' : spot.data.price === 2 ? '(mid-range)' : '(splurge)'}</dd></div>
    <div><dt>LAST VERIFIED</dt><dd>{verified}</dd></div>
    <div><dt>GRID REF</dt><dd>{spot.data.lat.toFixed(4)}, {spot.data.lng.toFixed(4)}</dd></div>
  </dl>

  <div class="section-head"><h2>FIELD LOG</h2></div>
  <div class="field-log">
    <Content />
  </div>

  <div class="section-head"><h2>WHAT TO ORDER</h2></div>
  <ul class="order-list">
    {spot.data.whatToOrder.map((item) => <li>{item}</li>)}
  </ul>

  <div class="section-head"><h2>SOURCES</h2></div>
  <ul class="sources">
    {spot.data.sources.map((s) => <li><a href={s}>{s}</a></li>)}
  </ul>

  <script>
    const btn = document.getElementById('tasted-btn');
    const slug = btn.dataset.slug;
    const paint = () => {
      const has = window.VP.has(slug);
      btn.textContent = has ? '✓ TASTED — UNDO' : 'MARK AS TASTED';
      btn.classList.toggle('solid', has);
    };
    btn.addEventListener('click', () => { window.VP.toggle(slug); paint(); });
    paint();
  </script>
</Base>
