---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const spots = await getCollection('restaurants');
  return spots.map((spot) => ({
    params: { slug: spot.id.replace(/\.mdx?$/, '') },
    props: { spot },
  }));
}

const { spot } = Astro.props;
const { Content } = await render(spot);
const cities = await getCollection('cities');
const city = cities.find((c) => c.id.replace(/\.mdx?$/, '') === spot.data.city);
const priceMarks = (n) => '$'.repeat(n);
const verified = spot.data.lastVerified.toISOString().slice(0, 10);
---

<Base title={spot.data.name} description={spot.data.summary}>
  <div class="detail-head">
    <p class="hero-kicker">😋 Pick #{String(spot.data.rank).padStart(3, '0')} · <a href={`/cities/${spot.data.city}/`}>{city?.data.title}</a></p>
    <h1>{spot.data.name}</h1>
    <p>
      {spot.data.rank === 1 && <span class="sticker top">👑 Top pick</span>}
      <span class={`sticker ${spot.data.veganStatus === 'all-vegan' ? 'vegan' : 'friendly'}`}>
        {spot.data.veganStatus === 'all-vegan' ? '🌱 100% vegan' : 'Vegan-friendly'}
      </span>
      <span class="sticker plain">{priceMarks(spot.data.price)}</span>
    </p>
    <div class="btn-row">
      <button class="btn" id="tasted-btn" data-slug={spot.id.replace(/\.mdx?$/, '')}>Been here? Mark it tasty</button>
    </div>
  </div>

  <dl class="facts">
    <div><dt>Cuisine</dt><dd>{spot.data.cuisine.join(', ')}</dd></div>
    <div><dt>Neighborhood</dt><dd>{spot.data.neighborhood}</dd></div>
    <div><dt>Address</dt><dd>{spot.data.address}</dd></div>
    <div><dt>Price</dt><dd>{priceMarks(spot.data.price)} {spot.data.price === 1 ? '(cheap eats)' : spot.data.price === 2 ? '(mid-range)' : '(splurge)'}</dd></div>
    <div><dt>Last checked</dt><dd>{verified}</dd></div>
  </dl>

  <div class="section-head"><h2>Why we love it 💚</h2></div>
  <div class="rundown">
    <Content />
  </div>

  <div class="section-head"><h2>What to order 🍽️</h2></div>
  <ul class="order-list">
    {spot.data.whatToOrder.map((item) => <li>{item}</li>)}
  </ul>

  <div class="section-head"><h2>Sources 🔗</h2></div>
  <ul class="sources">
    {spot.data.sources.map((s) => <li><a href={s}>{s}</a></li>)}
  </ul>

  <script>
    const btn = document.getElementById('tasted-btn');
    const slug = btn.dataset.slug;
    const paint = () => {
      const has = window.VP.has(slug);
      btn.textContent = has ? '✓ Tasty — undo' : 'Been here? Mark it tasty';
      btn.classList.toggle('solid', has);
    };
    btn.addEventListener('click', () => { window.VP.toggle(slug); paint(); });
    paint();
  </script>
</Base>
